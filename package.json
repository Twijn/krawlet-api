{
  "name": "krawlet-api",
  "version": "1.27.0",
  "description": "",
  "main": "dist/index.js",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:create": "npx sequelize-cli migration:generate --name",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "gen-apikey": "npx tsx src/scripts/generateApiKey.ts",
    "provision-transfer-key": "npx tsx src/scripts/provisionTransferKey.ts",
    "apikey-info": "npx tsx src/scripts/getApiKeyInfo.ts",
    "lint": "eslint src/**/*.ts --quiet",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "deploy-commands": "npx tsx src/discord/putCommands.ts",
    "version": "node scripts/sync-openapi-version.cjs && git add openapi.yaml"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/object-hash": "^3.0.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sequelize-cli": "^6.6.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.20",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "kromer": "^1.8.5",
    "mysql2": "^3.24.6",
    "object-hash": "^3.0.0",
    "reconnectedchat": "^3.4.1",
    "sequelize": "^6.37.8",
    "tsc-alias": "^1.9.8",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
