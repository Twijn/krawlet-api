{
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",

  "formatter": {
    "external": {
      "command": "npx",
      "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
    }
  },

  "languages": {
    "Lua": {
      "format_on_save": "off",
      "formatter": "language_server",
      "tab_size": 2,
      "hard_tabs": false
    }
  }
}
